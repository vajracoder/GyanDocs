PORT=5000
MONGODB_URI=your_mongodb_atlas_connection_string
CLIENT_URL=http://localhost:5173
FRONTEND_URL=https://gyandocs.ishandevp.in

# Maximum PDF upload size in MB (default: 10)
PDF_MAX_SIZE_MB=10

# Firebase Admin SDK credentials (server-side token verification)
# Obtain these from the Firebase console: Project Settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Email of the user to grant the admin custom claim (used by scripts/setAdminClaim.js)
# ADMIN_EMAIL=admin@example.com